SLACK_BOT_TOKEN=replace-with-your-slack-bot-token
SLACK_APP_TOKEN=replace-with-your-slack-app-token

LLM_PROVIDER=ollama
LLM_MODEL=qwen3.6-64k:27b

OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

RULES_PATH=rules/channels.md
STATE_DB_PATH=slackbot_state.db
BOT_TIMEZONE=America/Sao_Paulo

ALLOW_LLM_GENERATED_QUESTIONS=false
CONFIDENCE_THRESHOLD=0.65
AUTO_ROUTE_CONFIDENCE_THRESHOLD=0.85

SLACK_CHANNEL_MENU=C0000000000
SLACK_CHANNEL_TI=C0000000001
SLACK_CHANNEL_DADOS=C0000000002
SLACK_CHANNEL_PEOPLE=C0000000003
SLACK_CHANNEL_PLATAFORMA=C0000000004
SLACK_CHANNEL_SEGINFO=C0000000005
